# Copy to .env and edit. Everything is optional.

# Model: auto tries Ollama first, then OpenAI.
BESTIARY_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
BESTIARY_MODEL=qwen3.5:9b
# Extra JSON merged into every /v1/responses request, for example to turn thinking off
# on your Ollama version (check what it accepts during rehearsal):
# BESTIARY_EXTRA_BODY={"reasoning": {"effort": "none"}}

# OpenAI fallback (used only if the Ollama model is not available)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=<a model your key can use, with Responses API + function calling>

# Forge backend for encounter 8: local (offline) or github (real pull request)
BESTIARY_FORGE=local
# BESTIARY_GITHUB_REPO=mgonzalezo/farolito-demo
# GITHUB_TOKEN=github_pat_...

# Profile: laptop (default, everything on 127.0.0.1) or cloud (in-cluster service URLs; set by the console pod).
# BESTIARY_PROFILE=cloud
# Explicit values below always win over the profile defaults:
# BESTIARY_REVIEWER_URL=http://reviewer-a2a:9999
# BESTIARY_AGENT_ROUTER_URL=http://agent-router:1975
# BESTIARY_OPENENV_URL=http://openenv-farolito:8000
# BESTIARY_FAILOVER_MODEL=qwen3.5:4b
# BESTIARY_STATE_DIR=/state        # working copy shared by the game, forge MCP and goose
# BESTIARY_GITHUB_ISSUE=7          # issue number on GitHub (pods have no state file)
# OPEN_SANDBOX_API_KEY=            # required by the OpenSandbox Kubernetes runtime

# Language of the texts the game writes: es (default, Latin American Spanish) or en. The raw output of the real calls is never translated.
# BESTIARY_LANG=es
# Battle screens: choose (you pick the creature for each obstacle, default) or auto (the right one is already on the field)
# BESTIARY_PICK=choose

# Stage behaviour
BESTIARY_GOOSE_TIMEOUT=150
# BESTIARY_GOOSE_ATTEMPTS=2   # live attempts (each from the original code) before the known-good fix
# BESTIARY_GOOSE_CMD=goose run --with-builtin developer -t
BESTIARY_GATEWAY_URL=http://localhost:3000/mcp
OPEN_SANDBOX_DOMAIN=localhost:8080
BESTIARY_SANDBOX_IMAGE=bestiary-sandbox:latest
BESTIARY_TALK_BANNER=Talk version: Agentic Nights Lima, Nov 2026
